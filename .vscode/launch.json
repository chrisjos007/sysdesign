{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Django",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}\\manage.py",
            // Without this, debugpy auto-attaches to every child Python
            // process the server spawns -- including the coding-challenge
            // grading subprocess in learn/code_runner.py -- which prints its
            // own "Debugger warning: frozen modules..." banner into that
            // child's stdout/stderr and breaks grading (every test case
            // fails since the real program output gets pushed out/mixed in).
            // --noreload above removes the one legitimate case (Django's
            // autoreloader re-exec) this setting would otherwise be needed
            // for, so this has no real downside beyond restarting the debug
            // session manually after code changes instead of relying on
            // autoreload-while-debugging.
            "subProcess": false
        }
    ]
}
