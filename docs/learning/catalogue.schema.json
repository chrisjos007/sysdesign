{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SysDesign Quest learning catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "title",
    "content_version",
    "research_date",
    "status",
    "path_base",
    "source_registry",
    "stages",
    "summary",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "./catalogue.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "research_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "const": "documented_for_future_integration"
    },
    "path_base": {
      "const": "docs/learning"
    },
    "source_registry": {
      "const": "sources.json"
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "legacy_difficulty"
        ],
        "properties": {
          "id": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "production",
              "expert"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "legacy_difficulty": {
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lesson_count",
        "case_study_count",
        "question_count",
        "source_count",
        "estimated_minutes"
      ],
      "properties": {
        "lesson_count": {
          "type": "integer",
          "minimum": 0
        },
        "case_study_count": {
          "type": "integer",
          "minimum": 0
        },
        "question_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "answer",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(sd|cs)-[0-9]{2}-q[0-9]+$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_points",
        "suggested_mastery_points",
        "core_invariants_required",
        "criteria"
      ],
      "properties": {
        "maximum_points": {
          "const": 20
        },
        "suggested_mastery_points": {
          "const": 16
        },
        "core_invariants_required": {
          "const": true
        },
        "criteria": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "criterion",
              "evidence",
              "max_points"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "max_points": {
                "const": 4
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "components",
        "connections",
        "builder_brief"
      ],
      "properties": {
        "status": {
          "const": "reference_design"
        },
        "components": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "connections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "label"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "builder_brief": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "type",
        "title",
        "summary",
        "stage",
        "stage_order",
        "order",
        "estimated_minutes",
        "path",
        "prerequisite_ids",
        "related_existing_concept_slugs",
        "tags",
        "objectives",
        "source_ids",
        "suggested_topic",
        "legacy_difficulty",
        "content_status",
        "activities",
        "assessment"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(sd|cs)-[0-9]{2}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "lesson",
            "case_study"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced",
            "production",
            "expert"
          ]
        },
        "stage_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(lessons|case-studies)/[0-9]{2}-[a-z0-9-]+\\.md$"
        },
        "prerequisite_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sd-[0-9]{2}$"
          }
        },
        "related_existing_concept_slugs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 3
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "suggested_topic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slug",
            "status"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "existing",
                "proposed"
              ]
            }
          }
        },
        "legacy_difficulty": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "content_status": {
          "const": "documented"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "study",
              "practice",
              "design-practice",
              "knowledge-check",
              "architecture-builder-brief"
            ]
          }
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "questions"
          ],
          "properties": {
            "format": {
              "const": "short_answer"
            },
            "questions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/question"
              }
            },
            "rubric": {
              "$ref": "#/$defs/rubric"
            }
          }
        },
        "architecture": {
          "$ref": "#/$defs/architecture"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "lesson"
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^sd-"
              },
              "path": {
                "pattern": "^lessons/"
              },
              "assessment": {
                "properties": {
                  "questions": {
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            "not": {
              "required": [
                "architecture"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "case_study"
              }
            }
          },
          "then": {
            "required": [
              "architecture"
            ],
            "properties": {
              "id": {
                "pattern": "^cs-"
              },
              "path": {
                "pattern": "^case-studies/"
              },
              "assessment": {
                "required": [
                  "rubric"
                ],
                "properties": {
                  "questions": {
                    "minItems": 3,
                    "maxItems": 3
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

